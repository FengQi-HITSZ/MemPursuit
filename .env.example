# Copy this file to .env and fill your own credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional separate answer/judge routes (GPT or any OpenAI-compatible Qwen endpoint).
ANSWER_API_KEY=
ANSWER_BASE_URL=
ANSWER_MODEL=gpt-4o-mini
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=gpt-4o-mini
# Host port for the memory API.
MEM0_PORT=8889
MEM0_HOST=http://localhost:8889
# Fixed budget by default. Use configs/adaptive.yaml for the LoCoMo adaptive run.
MEM0_CONFIG_FILE=./configs/mempursuit.yaml
